# Port the app listens on.
PORT=8530
# Weather location (Open-Meteo), in decimal degrees. Set these to where you live;
# https://www.latlong.net finds them. Defaults are New York City.
LAT=40.7128
LON=-74.0060
# Dates and "today" follow this timezone (a TZ database name, e.g. Europe/London).
TZ=America/New_York
# Large screens (a tablet in the closet) return to the profiles screen after this many idle
# seconds. 0 turns it off.
IDLE_TIMEOUT_SECONDS=90
# Background removal service (the rembg container in docker-compose.yml).
REMBG_URL=http://rembg:7000
# Background removal model. isnet-general-use gives crisp edges (~5-8 s per photo);
# u2net is ~2x faster but softer. bria-rmbg needs a lot more RAM.
REMBG_MODEL=isnet-general-use

# Spotify (optional). Create an app at https://developer.spotify.com/dashboard. See README.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI in the Spotify app. Spotify requires HTTPS.
SPOTIFY_REDIRECT_URI=https://closet.example.com/api/spotify/callback

# "Make it perfect" (AI product shots of each piece). Leave the key empty to hide the button.
# Get a key at openrouter.ai (Settings → API Keys) and add a few dollars of credit.
OPENROUTER_API_KEY=
AI_MODEL=bytedance-seed/seedream-5-0-flash
# Optional fallback for pieces Seedream's filter refuses (e.g. prints of well-known characters).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
